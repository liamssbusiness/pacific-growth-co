# Required — for the AI qualifier/competitor/briefing flow
ANTHROPIC_API_KEY=sk-ant-...

# Optional — unlocks /admin/leads?token=... admin view. Any long random string.
# If unset, the admin page returns "not configured" and never reveals leads.
ADMIN_TOKEN=

# Optional — posts a lead alert to a Discord channel on every form submission.
# Create one: Discord → Server Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL.
# If unset, no notification is sent (the lead is still captured + logged).
DISCORD_WEBHOOK_URL=
